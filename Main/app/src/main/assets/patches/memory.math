(x: real, terabytes) "into" (y: real, pebibytes) :>55 = with_unit(x / y, y)

# ---- petabytes rows ----
(x: real, petabytes) "into" (y: real, bits) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, bytes) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, kilobytes) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, megabytes) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, gigabytes) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, terabytes) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, kibibytes) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, mebibytes) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, gibibytes) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, tebibytes) :>55 = with_unit(x / y, y)
(x: real, petabytes) "into" (y: real, pebibytes) :>55 = with_unit(x / y, y)

# ---- kibibytes rows ----
(x: real, kibibytes) "into" (y: real, bits) :>55 = with_unit(x / y, y)
(x: real, kibibytes) "into" (y: real, bytes) :>55 = with_unit(x / y, y)
(x: real, kibibytes) "into" (y: real, kilobytes) :>55 = with_unit(x / y, y)
(x: real, kibibytes) "into" (y: real, megabytes) :>55 = with_unit(x / y, y)
(x: real, kibibytes) "into" (y: real, gigabytes) :>55 = with_unit(x / y, y)
(x: real, kibibytes) "into" (y: real, terabytes) :>55 = with_unit(x / y, y)
(x: real, kibibytes) "into" (y: real, petabytes) :>55 = with_unit(x / y, y)
(x: real, kibibytes) "into" (y: real, mebibytes) :>55 = with_unit(x / y, y)
