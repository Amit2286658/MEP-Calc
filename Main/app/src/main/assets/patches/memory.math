# ==============================================================================
# patches/memory.math — Computer Memory / Storage Size Conversion (`memory`)
# ==============================================================================
# Converts between bit and byte based storage units using one shared base of BITS
# (1 byte = 8 bits). Two prefix families are supported and kept distinct:
#   • SI decimal   KB = 1000 B, MB = 1000 KB, ... (storage vendors, networking)
#   • IEC binary   KiB = 1024 B, MiB = 1024 KiB, ... (RAM, OS file sizes)
#
# Three ways to convert:
#   1. Unit suffixes + `into`:   1.5 GB into MiB   /   8 bit into byte
#   2. Plain function layer:     memory_convert(1.5, "GB", "MiB")
#   3. Formatting helpers:       memory_convert_str(512, "MB", "GiB")
#                                memory_human(1610612736)  -> "1.50 GiB"
#
# Exact for the full 64-bit-ish range representable in an IEEE-754 double.
# ==============================================================================
[memory]
<[arith]
<[string]

# ==============================================================================
# 1. Unit markers (every marker carries its factor in BITS)
# ==============================================================================
# -- bits --
(x) "bit" :95 -> real, bits = x * 1
(x) "bits" :95 -> real, bits = x * 1
(x) "b" :95 -> real, bits = x * 1

# -- bytes --
(x) "byte" :95 -> real, bytes = x * 8
(x) "bytes" :95 -> real, bytes = x * 8
(x) "B" :95 -> real, bytes = x * 8

# -- kilobytes --
(x) "KB" :95 -> real, kilobytes = x * 8000
(x) "kB" :95 -> real, kilobytes = x * 8000
(x) "kb" :95 -> real, kilobytes = x * 8000
(x) "kilobyte" :95 -> real, kilobytes = x * 8000
(x) "kilobytes" :95 -> real, kilobytes = x * 8000

# -- megabytes --
(x) "MB" :95 -> real, megabytes = x * 8000000
(x) "mb" :95 -> real, megabytes = x * 8000000
(x) "megabyte" :95 -> real, megabytes = x * 8000000
(x) "megabytes" :95 -> real, megabytes = x * 8000000

# -- gigabytes --
(x) "GB" :95 -> real, gigabytes = x * 8000000000
(x) "gb" :95 -> real, gigabytes = x * 8000000000
(x) "gigabyte" :95 -> real, gigabytes = x * 8000000000
(x) "gigabytes" :95 -> real, gigabytes = x * 8000000000

# -- terabytes --
(x) "TB" :95 -> real, terabytes = x * 8000000000000
(x) "tb" :95 -> real, terabytes = x * 8000000000000
(x) "terabyte" :95 -> real, terabytes = x * 8000000000000
(x) "terabytes" :95 -> real, terabytes = x * 8000000000000

# -- petabytes --
(x) "PB" :95 -> real, petabytes = x * 8000000000000000
(x) "pb" :95 -> real, petabytes = x * 8000000000000000
(x) "petabyte" :95 -> real, petabytes = x * 8000000000000000
(x) "petabytes" :95 -> real, petabytes = x * 8000000000000000

# -- kibibytes --
(x) "KiB" :95 -> real, kibibytes = x * 8192
(x) "kib" :95 -> real, kibibytes = x * 8192
(x) "kibibyte" :95 -> real, kibibytes = x * 8192
(x) "kibibytes" :95 -> real, kibibytes = x * 8192

# -- mebibytes --
(x) "MiB" :95 -> real, mebibytes = x * 8388608
(x) "mib" :95 -> real, mebibytes = x * 8388608
(x) "mebibyte" :95 -> real, mebibytes = x * 8388608
(x) "mebibytes" :95 -> real, mebibytes = x * 8388608

# -- gibibytes --
(x) "GiB" :95 -> real, gibibytes = x * 8589934592
(x) "gib" :95 -> real, gibibytes = x * 8589934592
(x) "gibibyte" :95 -> real, gibibytes = x * 8589934592
(x) "gibibytes" :95 -> real, gibibytes = x * 8589934592

# -- tebibytes --
(x) "TiB" :95 -> real, tebibytes = x * 8796093022208
(x) "tib" :95 -> real, tebibytes = x * 8796093022208
(x) "tebibyte" :95 -> real, tebibytes = x * 8796093022208
(x) "tebibytes" :95 -> real, tebibytes = x * 8796093022208

# -- pebibytes --
(x) "PiB" :95 -> real, pebibytes = x * 9007199254740992
(x) "pib" :95 -> real, pebibytes = x * 9007199254740992
(x) "pebibyte" :95 -> real, pebibytes = x * 9007199254740992
(x) "pebibytes" :95 -> real, pebibytes = x * 9007199254740992

# ==============================================================================
# 2. `from into to` conversion overloads (all cross-family pairs)
#    `with_unit(x / y, y)` divides the BITS-normalized left value by the
#    BITS value of one target unit and re-tags the result with the target group.
#    Same-group conversions are handled by stdlib conversions.math.
# ==============================================================================
# ---- bits rows ----
(x: real, bits) "into" (y: real, bytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, kilobytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, megabytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, gigabytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, terabytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, petabytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, kibibytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, mebibytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, gibibytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, tebibytes) :>55 = with_unit(x / y, y)
(x: real, bits) "into" (y: real, pebibytes) :>55 = with_unit(x / y, y)

# ---- bytes rows ----
(x: real, bytes) "into" (y: real, bits) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, kilobytes) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, megabytes) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, gigabytes) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, terabytes) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, petabytes) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, kibibytes) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, mebibytes) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, gibibytes) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, tebibytes) :>55 = with_unit(x / y, y)
(x: real, bytes) "into" (y: real, pebibytes) :>55 = with_unit(x / y, y)

# ---- kilobytes rows ----
(x: real, kilobytes) "into" (y: real, bits) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, bytes) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, megabytes) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, gigabytes) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, terabytes) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, petabytes) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, kibibytes) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, mebibytes) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, gibibytes) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, tebibytes) :>55 = with_unit(x / y, y)
(x: real, kilobytes) "into" (y: real, pebibytes) :>55 = with_unit(x / y, y)

# ---- megabytes rows ----
(x: real, megabytes) "into" (y: real, bits) :>55 = with_unit(x / y, y)
(x: real, megabytes) "into" (y: real, bytes) :>55 = with_unit(x / y, y)
(x: real, megabytes) "into" (y: real, kilobytes) :>55 = with_unit(x / y, y)
(x: real, megabytes) "into" (y: real, gigabytes) :>55 = with_unit(x / y, y)
(x: real, megabytes) "into" (y: real, terabytes) :>55 = with_unit(x / y, y)
(x: real, megabytes) "into" (y: real, petabytes) :>55 = with_unit(x / y, y)
(x: real, megabytes) "into" (y: real, kibibytes) :>55 = with_unit(x / y, y)
(x: real, megabytes) "into" (y: real, mebibytes) :>55 = with_unit(x / y, y)
