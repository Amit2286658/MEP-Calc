(x: real, kibibytes) "into" (y: real, pebibytes) :>55 = with_unit(x / y, y)

# ---- mebibytes rows ----
(x: real, mebibytes) "into" (y: real, bits) :>55 = with_unit(x / y, y)
(x: real, mebibytes) "into" (y: real, bytes) :>55 = with_unit(x / y, y)
(x: real, mebibytes) "into" (y: real, kilobytes) :>55 = with_unit(x / y, y)
