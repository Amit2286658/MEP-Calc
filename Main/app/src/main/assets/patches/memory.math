# ==============================================================================
# 3. String-code function layer (case-sensitive spellings; see memory_units())
# ==============================================================================
# @desc Returns how many BITS one unit represents. Accepts bit/byte family codes
#       such as "bit", "byte", "KB", "MiB", "TB", "PiB".
# @param unit: str — Unit code or long name (e.g. "GB", "gibibyte")
# @return real — Bits per unit (0 when the code is unknown)
memory_factor(unit: str) -> real = switch (trim(unit)) {
    case "bit": 1
    case "bits": 1
    case "b": 1
    case "byte": 8
    case "bytes": 8
    case "B": 8
    case "KB": 8000
    case "kB": 8000
    case "kb": 8000
    case "MB": 8000000
    case "mb": 8000000
    case "GB": 8000000000
    case "gb": 8000000000
    case "TB": 8000000000000
    case "tb": 8000000000000
    case "PB": 8000000000000000
    case "pb": 8000000000000000
    case "KiB": 8192
    case "kib": 8192
    case "MiB": 8388608
    case "mib": 8388608
    case "GiB": 8589934592
    case "gib": 8589934592
    case "TiB": 8796093022208
    case "tib": 8796093022208
    case "PiB": 9007199254740992
    case "pib": 9007199254740992
    else: 0
}

# @desc Converts a memory/storage amount between any two supported unit codes.
#       Formula: memory_convert(amount, from, to) = amount * bits(from) / bits(to)
# @param amount: real — Numeric value in the source unit
# @param from: str — Source unit code (e.g. "GB")
# @param to: str — Target unit code (e.g. "MiB")
# @return real — Converted value in the target unit
memory_convert(amount: real, from: str, to: str) -> real = {
    f := memory_factor(from)
    t := memory_factor(to)
    if (f == 0) { error("unknown source memory unit: " + from) }
    if (t == 0) { error("unknown target memory unit: " + to) }
    amount * f / t
}

# @desc Converts a memory amount and appends the target unit code.
#       Formula: memory_convert_str(amount, from, to) = fmt("%g %s", convert, to)
# @param amount: real — Numeric value in the source unit
# @param from: str — Source unit code
# @param to: str — Target unit code
# @return str — Converted value followed by the target code
memory_convert_str(amount: real, from: str, to: str) -> str = fmt("%g %s", memory_convert(amount, from, to), to)

# @desc Converts every amount in a vector between two memory units in one call.
# @param amounts: vec — Vector of numeric amounts in the source unit
# @param from: str — Source unit code
# @param to: str — Target unit code
# @return vec — Vector of converted amounts in the target unit
memory_convert_all(amounts: vec, from: str, to: str) -> vec = [memory_convert(a, from, to) for a in amounts]

# @desc Lists the canonical unit codes supported by this patch (ascending size).
# @return vec — Unit codes from bit through PiB
memory_units() -> vec<str> = {
    u := vec<str>()
    "bit" into u
    "byte" into u
    "KB" into u
    "MB" into u
    "GB" into u
    "TB" into u
    "PB" into u
    "KiB" into u
    "MiB" into u
    "GiB" into u
    "TiB" into u
    "PiB" into u
    u
}

# @desc Formats a BYTE count with binary (IEC) units, choosing the largest unit.
#       Example: memory_human(1610612736) = "1.50 GiB"
# @param bytes: real — Size in bytes
# @return str — Human-readable size string
memory_human(bytes: real) -> str = {
    b := bytes
    if (b < 0) { return "-" + memory_human(-b) }
    if (b < 1024) { return fmt("%g B", b) }
    if (b < 1048576) { return fmt("%.2f KiB", b / 1024) }
    if (b < 1073741824) { return fmt("%.2f MiB", b / 1048576) }
    if (b < 1099511627776) { return fmt("%.2f GiB", b / 1073741824) }
    if (b < 1125899906842624) { return fmt("%.2f TiB", b / 1099511627776) }
    fmt("%.2f PiB", b / 1125899906842624)
}

# ==============================================================================
# 4. Convenience aliases
# ==============================================================================

# @desc Alias for memory_convert. Formula: size_convert(amount, from, to)
# @param amount: real — Numeric value in the source unit
# @param from: str — Source unit code
# @param to: str — Target unit code
# @return real — Converted value in the target unit
size_convert(amount: real, from: str, to: str) -> real = memory_convert(amount, from, to)

# @desc Converts a BYTE count to kibibytes (KiB). Formula: bytes_to_kib(b) = b / 1024
# @param b: real — Size in bytes
# @return real — Size in kibibytes
bytes_to_kib(b: real) -> real = b / 1024

# @desc Converts a BYTE count to mebibytes (MiB). Formula: bytes_to_mib(b) = b / 1048576
# @param b: real — Size in bytes
# @return real — Size in mebibytes
bytes_to_mib(b: real) -> real = b / 1048576

# @desc Converts a BYTE count to gibibytes (GiB). Formula: bytes_to_gib(b) = b / 1073741824
# @param b: real — Size in bytes
# @return real — Size in gibibytes
bytes_to_gib(b: real) -> real = b / 1073741824

# @desc Converts a BYTE count to tebibytes (TiB). Formula: bytes_to_tib(b) = b / 1099511627776
# @param b: real — Size in bytes
# @return real — Size in tebibytes
bytes_to_tib(b: real) -> real = b / 1099511627776

# @desc Converts kibibytes (KiB) to BYTES. Formula: kib_to_bytes(k) = k * 1024
# @param k: real — Size in kibibytes
# @return real — Size in bytes
kib_to_bytes(k: real) -> real = k * 1024
