(x: real, gigabytes) "into" (y: real, pebibytes) :>55 = with_unit(x / y, y)

# ---- terabytes rows ----
(x: real, terabytes) "into" (y: real, bits) :>55 = with_unit(x / y, y)
(x: real, terabytes) "into" (y: real, bytes) :>55 = with_unit(x / y, y)
